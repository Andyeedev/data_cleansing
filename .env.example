# FS Migration Validation Engine - Environment Variables Template
# Copy this file to .env and fill in the required values.

# --- SECURITY ---
# Required for JWT token signing. Generate a strong random string.
JWT_SECRET_KEY=

# Application Administrator Credentials
APP_ADMIN_USER=
APP_ADMIN_PASS=

# --- DATABASE (Engine / Platform) ---
# Connection details for the migration engine database.
ENGINE_DB_HOST=localhost
ENGINE_DB_PORT=5432
ENGINE_DB_NAME=migration_engine
ENGINE_DB_USER=postgres
ENGINE_DB_PASS=

# --- OPTIONAL: SOURCE/TARGET DEFAULTS (if applicable) ---
# SOURCE_DB_HOST=
# SOURCE_DB_PASS=
# TARGET_DB_HOST=
# TARGET_DB_PASS=
