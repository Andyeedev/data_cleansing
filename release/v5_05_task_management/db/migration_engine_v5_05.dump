--
-- Name: v_batch_governance_summary; Type: VIEW; Schema: engine; Owner: postgres
--

CREATE VIEW engine.v_batch_governance_summary AS
 SELECT batch_id,
    count(*) AS total_rules,
    sum(
        CASE
            WHEN ((execution_status)::text = 'PASS'::text) THEN 1
            ELSE 0
        END) AS passed,
    sum(
        CASE
            WHEN ((execution_status)::text = 'FAIL'::text) THEN 1
            ELSE 0
        END) AS failed,
    sum(
        CASE
            WHEN ((execution_status)::text = 'ERROR'::text) THEN 1
            ELSE 0
        END) AS errors,
    max(created_at) AS last_execution_time
   FROM engine.migration_control_execution
  GROUP BY batch_id
  ORDER BY (max(created_at)) DESC;


ALTER VIEW engine.v_batch_governance_summary OWNER TO postgres;

--
-- Name: v_batch_monitor; Type: VIEW; Schema: engine; Owner: postgres
--

CREATE VIEW engine.v_batch_monitor AS
 SELECT batch_id,
    project_id,
    batch_status,
    batch_start_time,
    batch_end_time,
    total_controls,
    completed_controls,
    failed_controls,
        CASE
            WHEN (total_controls = 0) THEN (0)::numeric
            ELSE round((((completed_controls)::numeric / (total_controls)::numeric) * (100)::numeric), 2)
        END AS completion_percent
   FROM engine.migration_batch_registry
  ORDER BY batch_start_time DESC;


ALTER VIEW engine.v_batch_monitor OWNER TO postgres;

--
-- Name: v_dataset_risk_heatmap; Type: VIEW; Schema: engine; Owner: postgres
--

CREATE VIEW engine.v_dataset_risk_heatmap AS
 SELECT entity_name AS dataset_name,
    count(*) AS total_rules_executed,
    sum(
        CASE
            WHEN ((execution_status)::text = ANY ((ARRAY['FAIL'::character varying, 'ERROR'::character varying])::text[])) THEN 1
            ELSE 0
        END) AS failed_rules,
    round((((sum(
        CASE
            WHEN ((execution_status)::text = ANY ((ARRAY['FAIL'::character varying, 'ERROR'::character varying])::text[])) THEN 1
            ELSE 0
        END))::numeric / (NULLIF(count(*), 0))::numeric) * (100)::numeric), 2) AS failure_rate_percent
   FROM engine.migration_control_execution
  GROUP BY entity_name
  ORDER BY (round((((sum(
        CASE
            WHEN ((execution_status)::text = ANY ((ARRAY['FAIL'::character varying, 'ERROR'::character varying])::text[])) THEN 1
            ELSE 0
        END))::numeric / (NULLIF(count(*), 0))::numeric) * (100)::numeric), 2)) DESC;


ALTER VIEW engine.v_dataset_risk_heatmap OWNER TO postgres;

--
-- Name: v_dataset_risk_index; Type: VIEW; Schema: engine; Owner: postgres
--

CREATE VIEW engine.v_dataset_risk_index AS
 SELECT entity_name,
    count(*) AS total_rules,
    sum(
        CASE
            WHEN ((execution_status)::text = 'PASS'::text) THEN 0
            WHEN ((execution_status)::text = 'FAIL'::text) THEN 1
            WHEN ((execution_status)::text = 'ERROR'::text) THEN 2
            ELSE NULL::integer
        END) AS risk_points,
    round(((sum(
        CASE
            WHEN ((execution_status)::text = 'PASS'::text) THEN 0
            WHEN ((execution_status)::text = 'FAIL'::text) THEN 1
            WHEN ((execution_status)::text = 'ERROR'::text) THEN 2
            ELSE NULL::integer
        END))::numeric / (count(*))::numeric), 2) AS risk_index
   FROM engine.migration_control_execution
  GROUP BY entity_name
  ORDER BY (round(((sum(
        CASE
            WHEN ((execution_status)::text = 'PASS'::text) THEN 0
            WHEN ((execution_status)::text = 'FAIL'::text) THEN 1
            WHEN ((execution_status)::text = 'ERROR'::text) THEN 2
            ELSE NULL::integer
        END))::numeric / (count(*))::numeric), 2)) DESC;


ALTER VIEW engine.v_dataset_risk_index OWNER TO postgres;

--
-- Name: v_execution_anomalies; Type: VIEW; Schema: engine; Owner: postgres
--

CREATE VIEW engine.v_execution_anomalies AS
 SELECT rule_id,
    entity_name,
    execution_time_seconds,
    avg(execution_time_seconds) OVER (PARTITION BY rule_id, entity_name) AS avg_runtime,
        CASE
            WHEN (execution_time_seconds > (avg(execution_time_seconds) OVER (PARTITION BY rule_id, entity_name) * (2)::numeric)) THEN 'ANOMALY'::text
            ELSE 'NORMAL'::text
        END AS execution_flag
   FROM engine.migration_control_execution;


ALTER VIEW engine.v_execution_anomalies OWNER TO postgres;

--
-- Name: v_migration_health_dashboard; Type: VIEW; Schema: engine; Owner: postgres
--

CREATE VIEW engine.v_migration_health_dashboard AS
 SELECT b.batch_id,
    b.project_id,
    b.batch_start_time,
    b.batch_end_time,
    b.total_controls,
    b.completed_controls,
    b.failed_controls,
    g.migration_status,
    round((((b.completed_controls)::numeric / (NULLIF(b.total_controls, 0))::numeric) * (100)::numeric), 2) AS completion_percent
   FROM (engine.migration_batch_registry b
     LEFT JOIN engine.migration_governance_status g ON ((b.batch_id = g.batch_id)))
  ORDER BY b.batch_start_time DESC;


ALTER VIEW engine.v_migration_health_dashboard OWNER TO postgres;

--
-- Name: v_migration_score_trend; Type: VIEW; Schema: engine; Owner: postgres
--

CREATE VIEW engine.v_migration_score_trend AS
 SELECT batch_id,
    execution_start,
    overall_status,
    overall_score,
    avg(overall_score) OVER (ORDER BY execution_start ROWS BETWEEN 4 PRECEDING AND CURRENT ROW) AS rolling_5_batch_avg
   FROM engine.migration_validation_batch
  WHERE (overall_score IS NOT NULL)
  ORDER BY execution_start DESC;


ALTER VIEW engine.v_migration_score_trend OWNER TO postgres;

--
-- Name: v_migration_stability_score; Type: VIEW; Schema: engine; Owner: postgres
--

CREATE VIEW engine.v_migration_stability_score AS
 SELECT batch_id,
    count(*) AS total_rules,
    sum(
        CASE
            WHEN ((execution_status)::text = 'PASS'::text) THEN 1
            ELSE 0
        END) AS passed_rules,
    round((((sum(
        CASE
            WHEN ((execution_status)::text = 'PASS'::text) THEN 1
            ELSE 0
        END))::numeric / (count(*))::numeric) * (100)::numeric), 2) AS stability_score
   FROM engine.migration_control_execution
  GROUP BY batch_id
  ORDER BY batch_id DESC;


ALTER VIEW engine.v_migration_stability_score OWNER TO postgres;

--
-- Name: v_rule_failure_analysis; Type: VIEW; Schema: engine; Owner: postgres
--

CREATE VIEW engine.v_rule_failure_analysis AS
 SELECT rule_id,
    count(*) AS total_executions,
    sum(
        CASE
            WHEN ((execution_status)::text = ANY ((ARRAY['FAIL'::character varying, 'ERROR'::character varying])::text[])) THEN 1
            ELSE 0
        END) AS failures,
    round((((sum(
        CASE
            WHEN ((execution_status)::text = ANY ((ARRAY['FAIL'::character varying, 'ERROR'::character varying])::text[])) THEN 1
            ELSE 0
        END))::numeric / (NULLIF(count(*), 0))::numeric) * (100)::numeric), 2) AS failure_rate_percent
   FROM engine.migration_control_execution
  GROUP BY rule_id
  ORDER BY (round((((sum(
        CASE
            WHEN ((execution_status)::text = ANY ((ARRAY['FAIL'::character varying, 'ERROR'::character varying])::text[])) THEN 1
            ELSE 0
        END))::numeric / (NULLIF(count(*), 0))::numeric) * (100)::numeric), 2)) DESC, (sum(
        CASE
            WHEN ((execution_status)::text = ANY ((ARRAY['FAIL'::character varying, 'ERROR'::character varying])::text[])) THEN 1
            ELSE 0
        END)) DESC;


ALTER VIEW engine.v_rule_failure_analysis OWNER TO postgres;

--
-- Name: v_rule_failure_trend; Type: VIEW; Schema: engine; Owner: postgres
--

CREATE VIEW engine.v_rule_failure_trend AS
 SELECT rule_id,
    count(*) AS total_executions,
    sum(
        CASE
            WHEN ((execution_status)::text = ANY ((ARRAY['FAIL'::character varying, 'ERROR'::character varying])::text[])) THEN 1
            ELSE 0
        END) AS failures,
    round((((sum(
        CASE
            WHEN ((execution_status)::text = ANY ((ARRAY['FAIL'::character varying, 'ERROR'::character varying])::text[])) THEN 1
            ELSE 0
        END))::numeric / (count(*))::numeric) * (100)::numeric), 2) AS failure_rate_percent
   FROM engine.migration_control_execution
  GROUP BY rule_id
  ORDER BY (round((((sum(
        CASE
            WHEN ((execution_status)::text = ANY ((ARRAY['FAIL'::character varying, 'ERROR'::character varying])::text[])) THEN 1
            ELSE 0
        END))::numeric / (count(*))::numeric) * (100)::numeric), 2)) DESC;


ALTER VIEW engine.v_rule_failure_trend OWNER TO postgres;

--
-- Name: v_slowest_controls; Type: VIEW; Schema: engine; Owner: postgres
--

CREATE VIEW engine.v_slowest_controls AS
 SELECT control_id,
    rule_id,
    entity_name,
    avg(execution_time_seconds) AS avg_execution_time,
    max(execution_time_seconds) AS max_execution_time,
    count(*) AS executions
   FROM engine.migration_control_execution
  GROUP BY control_id, rule_id, entity_name;


ALTER VIEW engine.v_slowest_controls OWNER TO postgres;

