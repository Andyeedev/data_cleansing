    INSERT INTO engine.migration_batch_intelligence (
        batch_id,
        rolling_window_size,
        avg_score_last_n,
        stability_score,
        risk_heat_index,
        repeat_failure_index,
        execution_time_zscore,
        anomaly_score,
        anomaly_flag,
        auto_blocked,
        created_at
    )
    VALUES (
        p_batch_id,
        v_window,
        v_avg_score,
        v_stability,
        v_risk,
        v_repeat,
        v_exec_z,
        v_anomaly,
