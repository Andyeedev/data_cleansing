--
-- Name: security_events; Type: TABLE; Schema: audit; Owner: postgres
--

CREATE TABLE audit.security_events (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    "timestamp" timestamp with time zone DEFAULT now() NOT NULL,
    event_type character varying(100) NOT NULL,
    user_id uuid,
    user_email character varying(255),
    severity character varying(20) DEFAULT 'info'::character varying,
    ip_address inet,
    user_agent text,
    request_id character varying(255),
    details jsonb DEFAULT '{}'::jsonb,
    risk_score numeric(5,2),
    blocked boolean DEFAULT false,
    created_at timestamp with time zone DEFAULT now(),
    CONSTRAINT security_events_event_type_check CHECK (((event_type)::text = ANY ((ARRAY['login_success'::character varying, 'login_failure'::character varying, 'logout'::character varying, 'password_change'::character varying, 'password_reset_request'::character varying, 'password_reset_complete'::character varying, 'mfa_enable'::character varying, 'mfa_disable'::character varying, 'mfa_challenge_success'::character varying, 'mfa_challenge_failure'::character varying, 'account_locked'::character varying, 'account_unlocked'::character varying, 'account_deactivated'::character varying, 'role_assigned'::character varying, 'role_removed'::character varying, 'permission_granted'::character varying, 'permission_revoked'::character varying, 'session_created'::character varying, 'session_expired'::character varying, 'session_revoked'::character varying, 'token_refreshed'::character varying, 'token_revoked'::character varying, 'unauthorized_access_attempt'::character varying, 'rate_limit_exceeded'::character varying, 'suspicious_activity'::character varying, 'brute_force_detected'::character varying])::text[]))),
    CONSTRAINT security_events_severity_check CHECK (((severity)::text = ANY ((ARRAY['info'::character varying, 'warning'::character varying, 'critical'::character varying])::text[])))
);


ALTER TABLE audit.security_events OWNER TO postgres;

