    v_repeat numeric := 0;
    v_stability numeric := 0;
    v_exec_z numeric := 0;
    v_anomaly numeric := 0;

    v_flag boolean := false;
    v_block boolean := false;
BEGIN

    -- ==========================
    -- Load Configuration
    -- ==========================

    SELECT rolling_window_size,
           anomaly_block_threshold,
           repeat_failure_threshold,
           volatility_multiplier
